{
  "name": "Nathan-coffee-mart-monorepo",
  "version": "1.0.0",
  "description": "Nathan Coffee Mart - E-Commerce MERN Platform",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,yellow\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "Nathan coffee",
    "filter coffee powder",
    "Thanjavur coffee",
    "thanjavur coffee",
    "mern ecommerce"
  ],
  "author": "Nathan Coffee Mart",
  "license": "ISC"
}
