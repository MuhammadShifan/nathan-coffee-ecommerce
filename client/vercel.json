{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://nathan-coffee-ecommerce-tk06.onrender.com/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://nathan-coffee-ecommerce-tk06.onrender.com/uploads/:path*"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/sitemap.xml"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/Nlogo.jpg",
            "destination": "/Nlogo.jpg"
        },
        {
            "source": "/((?!api|uploads|sitemap\\.xml|robots\\.txt|Nlogo\\.jpg).*)",
            "destination": "/index.html"
        }
    ]
}